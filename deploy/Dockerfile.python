# Python 3 Production Dockerfile for Mercury
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends     build-essential     curl     ffmpeg     tesseract-ocr     && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY mercury/ ./mercury/
COPY web/ ./web/
COPY data/ ./data/

RUN pip install --no-cache-dir -e .

EXPOSE 8000
EXPOSE 8080

CMD ["python3", "-m", "mercury.ui.server", "--host", "0.0.0.0", "--port", "8000"]
