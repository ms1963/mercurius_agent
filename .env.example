# ==============================================================================
# 💠 Mercurius Agentic AI System - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary LLM Provider: Abacus AI ChatLLM (Default Out-of-the-Box)
# Simply insert your original Abacus AI API key below. No other LLM setup needed!
# ------------------------------------------------------------------------------
ABACUS_API_KEY=your_abacus_ai_api_key_here
CHATLLM_BASE_URL=https://paas.api.abacus.ai/v1
MERCURIUS_LLM_PROVIDER=chatllm
MERCURIUS_LLM_MODEL=gpt-6.1-sol

# ------------------------------------------------------------------------------
# 2. System & Core Settings
# ------------------------------------------------------------------------------
NODE_ENV=production
MERCURIUS_LOCALE=en
MERCURIUS_PORT=8000
MERCURIUS_MCP_PORT=8080
MERCURIUS_STORAGE_DIR=./data
MERCURIUS_JWT_SECRET=mercury_master_jwt_secret_posa_2026

# ------------------------------------------------------------------------------
# 3. Jev System-1 Calibrated Decision Engine (TypeSafe AI)
# ------------------------------------------------------------------------------
MERCURIUS_JEV_ENABLED=true
MERCURIUS_JEV_ENDPOINT=https://api.typesafe.ai/v1/jev
MERCURIUS_JEV_API_KEY=jev_prod_key_typesafe

# ------------------------------------------------------------------------------
# 4. Optional Secondary / Fallback Providers
# ------------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# ------------------------------------------------------------------------------
# 5. External Channels (Optional)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
SIGNAL_API_ENDPOINT=
EMAIL_IMAP_SERVER=
EMAIL_SMTP_SERVER=
EMAIL_USER=
EMAIL_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Additional Supported Providers (Google, xAI Grok, Kimi, MiniMax, DeepSeek)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
GROK_API_KEY=
MOONSHOT_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
DEEPSEEK_API_KEY=
